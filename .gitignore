# Terraform working directories and caches
**/.terraform/
# .terraform.lock.hcl is intentionally NOT ignored — commit it to pin provider versions.

# State files — never commit state to source control
*.tfstate
*.tfstate.backup

# Saved plan files — binary files generated by terraform plan
*.tfplan

# Crash logs
crash.log
crash.*.log

# Sensitive variable files — use environment variables or a secrets manager
*.tfvars.secret

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# terraform-docs generated files (regenerated on demand)
# Comment out if you want to commit generated docs.
# modules/*/README.md

# OS artefacts
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Local act simulation — not part of the tracked codebase
.actrc
.secrets.act
.secrets.act.template
scripts/simulate-ci.sh
scripts/ci-events/
